# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
JWT_ACCESS_SECRET=<strong-access-token-secret>
JWT_REFRESH_SECRET=<strong-refresh-token-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
# Comma-separated origins are supported for local, production, and preview URLs.
FRONTEND_URL=http://localhost:3000,https://kaimana-front-end.vercel.app

# Code Execution
# Use a deployed Piston-compatible runner in production.
PISTON_URL=https://<piston-runner-host>

# AI
ANTHROPIC_API_KEY=<anthropic-api-key>

# Socket.IO
SOCKET_PORT=

# Execution Visualizer (Feature flag)
# Off by default. A traced run is a second, much slower Judge0 submission on
# top of the normal one, so enable it only where the judge can take the load.
FEATURE_EXECUTION_VISUALIZER=false
