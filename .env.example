NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Comma-separated browser origins; do not include a trailing slash.
FRONTEND_URL=http://localhost:3000,https://your-frontend.vercel.app
# Vercel cannot reach localhost. Use a public Piston-compatible runner URL,
# or leave it unset while code execution is disabled.
PISTON_URL=http://localhost:2000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
